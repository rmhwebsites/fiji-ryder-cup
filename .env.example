# ── Supabase ──────────────────────────────────────────────────────────────
# Both from the dashboard: Project Settings → API Keys.
#
# The publishable key (sb_publishable_...) is built for browsers — it ships in
# the client bundle, and row level security is what stands behind it. Leave
# both blank to run the app in device-local mode — everything works, it just
# doesn't sync between phones.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The SECRET key (sb_secret_...) bypasses row level security. It is only read
# by `npm run reset` (wipes the board before the round) and must NEVER gain a
# NEXT_PUBLIC_ prefix — that prefix is what tells Next.js to ship a value to
# every browser.
SUPABASE_SECRET_KEY=

# ── Scoring code ──────────────────────────────────────────────────────────
# One code unlocks scoring for everyone. Defaults to 3454 if unset.
NEXT_PUBLIC_SCORING_PIN=3454
