# ── Supabase ──────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → Data API (and API Keys).
# Leave both blank to run the app in device-local mode — everything works,
# it just doesn't sync between phones.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Scoring code ──────────────────────────────────────────────────────────
# One code unlocks scoring for everyone. Defaults to 1848 if unset.
NEXT_PUBLIC_SCORING_PIN=1848
